<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/kernelNameText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Vector Add"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/deviceChipText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="detecting device…"
            android:textColor="@color/dim"
            android:textSize="12sp" />

        <Button
            android:id="@+id/runButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/accent"
            android:text="Run"
            android:textColor="@color/bg" />
    </LinearLayout>

    <!-- 3-pane columns -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- LEFT: palette -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="28"
            android:background="@color/panel"
            android:orientation="vertical">

            <TextView
                style="@style/PaneHeader"
                android:text="Palette" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/paletteList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <TextView
                android:id="@+id/detailBand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/panel2"
                android:padding="12dp"
                android:text="Tap a built-in above for its full description."
                android:textColor="@color/dim"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/line" />

        <!-- MIDDLE: code -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="44"
            android:background="@color/bg"
            android:orientation="vertical">

            <TextView
                android:id="@+id/codeHeaderText"
                style="@style/PaneHeader"
                android:text="vector_add.comp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/codeList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="8dp" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Workgroup Size: 64 × 1 × 1 (fixed)"
                    android:textColor="@color/faint"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="Dispatch Grid X"
                    android:textColor="@color/dim"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/dispatchGroupsXInput"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:background="@color/panel2"
                    android:gravity="center"
                    android:inputType="number"
                    android:minHeight="0dp"
                    android:padding="6dp"
                    android:text="16"
                    android:textColor="@color/accent_text"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/line" />

        <!-- RIGHT: output -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="28"
            android:background="@color/panel"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/panel"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/tabBuffer"
                    style="@style/OutputTab"
                    android:text="Buffer" />

                <Button
                    android:id="@+id/tabTimeline"
                    style="@style/OutputTab"
                    android:text="Timeline" />

                <Button
                    android:id="@+id/tabConsole"
                    style="@style/OutputTab"
                    android:text="Console" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/bufferScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/bufferList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <TextView
                android:id="@+id/timelineView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="12dp"
                android:textColor="@color/text"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/consoleView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:textColor="@color/text"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
